generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model ReferenceFile {
  id          Int    @id @default(autoincrement())
  name        String
  path        String @unique
  description String
  order       Int
}

model CadenceItem {
  id    Int    @id @default(autoincrement())
  mode  String
  label String
  value String
  order Int

  @@unique([mode, order])
}

model WeeklyCalendarItem {
  id    Int    @id @default(autoincrement())
  day   String
  item  String
  order Int    @unique
}

model TimelineWeek {
  week     Int    @id
  theme    String
  carousel String
  short    String
  article  String
  linkedin String
  topicId  String
  topic    Topic  @relation(fields: [topicId], references: [id])
}

model Topic {
  id       String         @id
  cluster  String
  pillar   String
  title    String
  pain     String
  promise  String
  carousel String
  short    String
  article  String
  linkedin String?
  cta      String
  folders  TopicFolder[]
  timeline TimelineWeek[]
}

model TopicFolder {
  id      Int    @id @default(autoincrement())
  topicId String
  value   String
  order   Int
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, order])
}

model ContentFormat {
  key   String @id
  label String
  order Int    @unique
}
